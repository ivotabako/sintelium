{
  "name": "sintelium",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "ALLOW_UNCONFIGURED_CONTACT=true node scripts/build.mjs && vite --host 0.0.0.0",
    "validate": "ALLOW_UNCONFIGURED_CONTACT=true node scripts/validate-content.mjs",
    "build": "ALLOW_UNCONFIGURED_CONTACT=true node scripts/build.mjs && vite build && node scripts/finalize-dist.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:dist": "ALLOW_UNCONFIGURED_CONTACT=true node scripts/check-dist.mjs",
    "preview": "ALLOW_UNCONFIGURED_CONTACT=true vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "vite": "^5.4.10"
  }
}
