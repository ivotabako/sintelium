{
  "name": "sintelium",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "validate": "node scripts/run.mjs validate",
    "build": "node scripts/run.mjs build",
    "test": "node --test tests/*.test.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check": "npm run check:syntax && npm run validate && npm test && npm run build && npm run check:dist"
  },
  "devDependencies": {
    "vite": "^5.4.10"
  }
}
